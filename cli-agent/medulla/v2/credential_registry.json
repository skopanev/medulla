{
  "version": 1,
  "bundles": [
    "agy-keychain",
    "claude",
    "codex",
    "gemini",
    "google-application-credentials",
    "opencode"
  ],
  "harnesses": {
    "agy": {
      "env": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "VERTEX_LOCATION"
      ],
      "bundles": ["agy-keychain", "gemini", "google-application-credentials"]
    },
    "claude-code": {
      "env": ["ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "ZHIPU_API_KEY"],
      "bundles": ["claude"]
    },
    "codex": {
      "env": ["OPENAI_API_KEY"],
      "bundles": ["codex"]
    },
    "fake": {
      "env": [],
      "bundles": []
    },
    "opencode": {
      "env": [],
      "bundles": ["opencode"]
    },
    "shell": {
      "env": [],
      "bundles": []
    }
  }
}
